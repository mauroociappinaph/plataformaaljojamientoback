{
  "info": {
    "name": "Vacacional API",
    "description": "API para la plataforma de alojamiento vacacional",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Registro de Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"test123\",\n    \"name\": \"Test User\"\n}"
            },
            "description": "Registra un nuevo usuario en el sistema"
          }
        },
        {
          "name": "Login de Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"test123\"\n}"
            },
            "description": "Inicia sesión de un usuario y obtiene un token JWT"
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Crear Categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/categories",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Casa de Playa\",\n    \"description\": \"Propiedades ubicadas en zonas costeras\"\n}"
            },
            "description": "Crea una nueva categoría de propiedades"
          }
        },
        {
          "name": "Obtener Todas las Categorías",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/categories",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["categories"]
            },
            "description": "Obtiene la lista de todas las categorías"
          }
        },
        {
          "name": "Obtener Categoría por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:3000/categories/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "ID de la categoría"
                }
              ]
            },
            "description": "Obtiene una categoría específica por su ID"
          }
        },
        {
          "name": "Actualizar Categoría",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:3000/categories/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "ID de la categoría a actualizar"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Casa de Playa Actualizada\",\n    \"description\": \"Propiedades ubicadas en zonas costeras - Actualizado\"\n}"
            },
            "description": "Actualiza una categoría existente"
          }
        },
        {
          "name": "Eliminar Categoría",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "http://localhost:3000/categories/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "ID de la categoría a eliminar"
                }
              ]
            },
            "description": "Elimina una categoría existente"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
