generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Property {
    id                 String             @id @default(uuid())
    title              String
    description        String
    hostId             String // ID del usuario host en user-service
    status             PropertyStatus     @default(DRAFT)
    type               PropertyType
    address            Address            @relation(fields: [addressId], references: [id])
    addressId          String             @unique
    bedrooms           Int
    bathrooms          Int
    maxGuests          Int
    pricePerNight      Decimal            @db.Decimal(10, 2)
    cleaningFee        Decimal?           @db.Decimal(10, 2)
    serviceFee         Decimal?           @db.Decimal(10, 2)
    basePrice          Decimal            @db.Decimal(10, 2)
    minimumStay        Int                @default(1)
    instantBooking     Boolean            @default(false)
    houseRules         String?
    cancellationPolicy CancellationPolicy @default(FLEXIBLE)
    amenities          PropertyAmenity[]
    images             PropertyImage[]
    availability       Availability[]
    createdAt          DateTime           @default(now())
    updatedAt          DateTime           @updatedAt
}

model Address {
    id         String    @id @default(uuid())
    street     String
    city       String
    state      String?
    postalCode String
    country    String
    latitude   Float?
    longitude  Float?
    property   Property?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
}

model PropertyAmenity {
    id         String   @id @default(uuid())
    propertyId String
    amenityId  String
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@unique([propertyId, amenityId])
}

model PropertyImage {
    id         String   @id @default(uuid())
    propertyId String
    url        String
    caption    String?
    isPrimary  Boolean  @default(false)
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model Availability {
    id          String   @id @default(uuid())
    propertyId  String
    startDate   DateTime
    endDate     DateTime
    isAvailable Boolean
    customPrice Decimal? @db.Decimal(10, 2)
    property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([propertyId, startDate, endDate])
}

enum PropertyStatus {
    DRAFT
    PUBLISHED
    UNPUBLISHED
    UNDER_REVIEW
    DELETED
}

enum PropertyType {
    APARTMENT
    HOUSE
    CONDO
    VILLA
    CABIN
    COTTAGE
    LOFT
    OTHER
}

enum CancellationPolicy {
    FLEXIBLE
    MODERATE
    STRICT
    NON_REFUNDABLE
}
