                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "ID de la categoría a actualizar"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Casa de Playa Actualizada\",\n    \"description\": \"Propiedades ubicadas en zonas costeras - Actualizado\"\n}"
            },
            "description": "Actualiza una categoría existente"
          }
        },
        {
          "name": "Eliminar Categoría",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
