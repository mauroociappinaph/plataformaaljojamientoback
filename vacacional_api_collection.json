            "url": {
              "raw": "{{baseUrl}}/categories/:id",
              "host": ["{{baseUrl}}"],
              "path": ["categories", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "",
                  "description": "ID de la categoría a eliminar"
                }
              ]
            },
            "description": "Elimina una categoría existente"
          }
